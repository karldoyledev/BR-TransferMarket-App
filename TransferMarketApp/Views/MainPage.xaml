<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransferMarketApp.Core.ViewModels"
             x:Class="TransferMarketApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">
        <Label Text="🏟️"
               FontSize="64"
               HorizontalOptions="Center" />

        <Label Text="{Binding WelcomeMessage}"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Transfer market dashboard coming soon."
               FontSize="15"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
               HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>